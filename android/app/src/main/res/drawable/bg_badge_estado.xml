<?xml version="1.0" encoding="utf-8"?>
<!-- Fondo del recuadro de estado (confirmada/cancelada/pendiente/atendida) en el historial.
     El color se ajusta por código según el estado de cada cita (ver AdapterHistorialCita). -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <corners android:radius="10dp" />
    <solid android:color="#4CAF50" />
    <padding
        android:left="8dp"
        android:top="2dp"
        android:right="8dp"
        android:bottom="2dp" />
</shape>
