<?xml version="1.0" encoding="utf-8"?>
<androidx.appcompat.widget.LinearLayoutCompat xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".view.CitasFragment">
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="CITAS"
        android:textStyle="bold"
        android:textSize="35dp"
        android:fontFamily="@font/poppins_bold"
        android:layout_marginBottom="20dp"
        android:layout_marginTop="30dp"
        android:layout_gravity="center_horizontal"
        />

    <!-- FrameLayout en vez de que el FAB sea un hermano más del LinearLayout:
         así el botón SÍ flota en la esquina inferior derecha sobre el RecyclerView
         (con gravity) en lugar de ocupar su propia fila y taparse con la última tarjeta. -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvCitaActiva"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingBottom="80dp" />

        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/AddCitas"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|end"
            android:layout_margin="16dp"
            app:srcCompat="@drawable/icon_add"
            app:elevation="6dp"
            app:backgroundTint="@color/celesteoscuro"
            app:maxImageSize="40dp"
            app:tint="@color/white" />

    </FrameLayout>



</androidx.appcompat.widget.LinearLayoutCompat>